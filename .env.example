# ===== AI PROVIDER =====
PROVIDER=gemini
GEMINI_API_KEY=masukkan_key_gemini_di_sini      # gratis: aistudio.google.com/app/apikey
OPENROUTER_API_KEY=masukkan_key_openrouter_di_sini

# ===== SERVER =====
PORT=3000
# BASE_URL=https://kimibot-xxxx.onrender.com    # WAJIB diisi jika pakai Google OAuth saat deploy

# ===== RATE LIMIT (request per IP per 10 menit ke endpoint AI) =====
RATE_LIMIT_MAX=30

# ===== DATABASE =====
# Isi DATABASE_URL untuk pakai PostgreSQL (schema dibuat otomatis saat start).
# Render: New → PostgreSQL → copy "Internal Database URL" ke sini.
# Kosongkan untuk pakai JSON file lokal (default: ./data/db.json).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_PATH=./data/db.json

# ===== GOOGLE OAUTH (opsional — biarkan kosong utk nonaktif) =====
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
